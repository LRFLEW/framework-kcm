# Maintainer: Yousef <github-viral8565@pxdmail.com>
#
# Built by CI from a `git archive` tarball placed next to this file
# (see .github/workflows/build.yml). CI also fills in pkgver and url.

pkgname=framework-kcm
pkgver=0.1.2
pkgrel=1
pkgdesc='System Settings module for Framework laptops: charge limit, fans, touchpad, LEDs and firmware info'
arch=('x86_64')
url='https://github.com/OWNER/framework-kcm'
license=('GPL-3.0-or-later')
# dbus, kirigami, polkit and qt6-declarative are only used at runtime (bus
# policy, QML modules), so namcap can't see them
depends=(
  'dbus'
  'glibc'
  'hicolor-icon-theme'
  'kcmutils'
  'kcoreaddons'
  'ki18n'
  'kirigami'
  'libgcc'
  'libstdc++'
  'polkit'
  'qt6-base'
  'qt6-declarative'
  'systemd-libs'
)
makedepends=('cmake' 'extra-cmake-modules' 'git' 'rust')
install=framework-kcm.install
# GCC LTO objects from hidapi's bundled C code can't be read by the linker cargo uses
options=('!lto')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  export CARGO_HOME="$srcdir/cargo-home"
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
